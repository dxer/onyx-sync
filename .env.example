# ==========================================
# Onyx Sync Server Configuration
# ==========================================

# 服务监听端口
PORT=8080

# 超级管理员账户配置 (仅首次启动时初始化; 之后修改此处不会影响已有账户,
# 改密码请走管理控制台用户管理, 忘记密码见 README "Account recovery")
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 元数据存储 (SQLite 数据库文件路径)
DB_PATH=./data/sync.db

# 文件密文块存储类型: local (本地文件系统) 或 s3 (兼容 S3 对象存储 / Cloudflare R2)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./data/blobs

# S3 对象存储配置 (当 STORAGE_TYPE=s3 时生效)
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=onyx-blobs
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=blobs

# 浏览器跨域白名单 (逗号分隔, 如 https://dashboard.example.com,https://app.example.com)
# 同源 dashboard 与 Obsidian 原生客户端不需要配置; 为空表示允许所有 Origin (不推荐用于生产)
# CORS_ORIGINS=

# 登录限流: 每个 IP 在窗口期内允许的失败次数 (默认 10 次 / 600 秒)
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=600

# 日志: 级别 debug/info/warn/error (默认 info), 格式 text/json (默认 text, json 供 Loki/ELK 采集)
# LOG_LEVEL=info
# LOG_FORMAT=text

# 优雅停机: 收到 SIGTERM/SIGINT 后的排水宽限 (毫秒, 默认 10000, 需配合 compose stop_grace_period)
# SHUTDOWN_TIMEOUT_MS=10000
